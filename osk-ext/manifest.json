{
  "manifest_version": 3,
  "name": "AquaGen On-Screen Keyboard",
  "version": "1.0",
  "description": "Shows the touch keyboard only while a text field is focused.",
  "host_permissions": ["http://127.0.0.1:8577/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["*://web.aquagen.co.in/*"],
      "js": ["cs.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
